+/**
+ * Where a RUNNING walk-off lands (BUILD-26b; STAGE-RULES "A dead end's fall is where a walk off lands"): he leaves the end at a run
+ * (PHYS.maxRun) and keeps on the way he was going while he falls (gravity PHYS.gravDown, capped at PHYS.maxFall), so he lands 90-200
+ * px past the end, over wood a step straight down would land on; the tower's walls stop him at [20, width - 20]. `side`: 1 off the
+ * right end, -1 off the left. Returns the first sound wood his feet (his middle) come down on (`y` its top, `x` where), or undefined.
+ * `at(d)`: his x when he has fallen `d` px, for a catch laid at that depth.
+ */
+export function walkOffLand(platforms: readonly Platform[], end: number, y0: number, side: 1 | -1, width: number, but?: Platform): { land?: { x: number; y: number }; at: (d: number) => number } {
+  const DT = 1 / 60;
+  const xAt = (t: number) => Math.max(20, Math.min(width - 20, end + side * (8 + PHYS.maxRun * t)));
+  const tAt = (d: number) => {
+    // (falling from rest: half g t^2 until he reaches the cap, then the cap)
+    const tCap = PHYS.maxFall / PHYS.gravDown, dCap = (PHYS.maxFall * tCap) / 2;
+    return d <= dCap ? Math.sqrt((2 * d) / PHYS.gravDown) : tCap + (d - dCap) / PHYS.maxFall;
+  };
+  const at = (d: number) => xAt(tAt(Math.max(0, d)));
+  let y = 0, vy = 0;
+  for (let t = 0; t < 6; t += DT) {
+    const y1 = y + vy * DT;
+    vy = Math.min(PHYS.maxFall, vy + PHYS.gravDown * DT);
+    const x = xAt(t + DT);
+    let best: Platform | undefined;
+    for (const q of platforms) {
+      if (q === but || q.type === 'fragile' || x < q.x || x > q.x + q.width || q.y - y0 <= y || q.y - y0 > y1) continue;
+      if (!best || q.y < best.y) best = q;
+    }
+    if (best) return { land: { x, y: best.y }, at };
+    y = y1;
+  }
+  return { at };
+}
