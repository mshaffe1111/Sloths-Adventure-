+ * draw), by inventory id (Post.art: w2-props#door, w2-next#doorOpen, #letter/#letterB, #reply/#replyB). Nothing is drawn until the
+ * art is packed and loaded: no code-drawn stand-in (the lead's rule for a shipped stage); a letter or reply falls back to the plain
+ * petal (drawPostItem returns false).
+ */
+import type { Post, PostDoor } from './post.ts';
+import type { Collectible } from './types.ts';
+
+export function drawDoor(_ctx: CanvasRenderingContext2D, _post: Post, _d: PostDoor, _open: boolean, _view: { x: number; y: number; w: number; h: number; zoom: number }): void {}
+
+/** a letter or a reply in its art; false when the art is not ready (the caller draws the plain petal) */
+export function drawPostItem(_ctx: CanvasRenderingContext2D, _c: Collectible, _t: number): boolean {
+  return false;
+}
