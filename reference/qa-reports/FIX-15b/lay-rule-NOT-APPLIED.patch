+const GATE_LEVEL = 30;
+/** the margin his drawn head keeps under a sealed piece's drawn wood (px; HEAD's own margin) */
+const SEALED_CLEAR = 12;
+/**
+ * The room a sealed piece (a shut fig gate's bough) needs under its line for him to stand there with his DRAWN head clear of its DRAWN
+ * wood (FIX-15, R-165.212: a ledge 99 px under a gate's sagged end put his head 72 px into the thatch; HEAD reads his 48 px collider and
+ * a flat bough): the far end's full sag (GATE.sag: read along the whole span, as the lay does not know which end sags), its drawn
+ * underside (GATE.depth of its span), his drawn height (GATE.head, D41) and a margin.
+ */
+export const sealedRoom = (g: { width: number }): number => GATE.sag + GATE.depth * g.width + GATE.head + SEALED_CLEAR;
+/**
+ * Wood at (x0-x1, y) under a sealed piece's level that would give him the shut gate without opening it (FIX-15b, R-165.212, Matt: "it
+ * let me go above the platform"; a shut bough is footing from above, fieldPlay.ts): 'onto', wood not wholly under its lid (fieldPlay.ts
+ * lid: every rise from there stops at its underside, GATE.lidSide past either end) from which a jump (leaps, generous) reaches its drawn
+ * top at its sagged far end, the lowest it is drawn: he would stand ON the shut gate; 'low', wood under its span (or within GATE.lidSide
+ * of an end) with less room than sealedRoom: his drawn head would be in its drawn wood. Undefined: neither (or wood at its level or over
+ * it: towerGates' "passed" rule). The lay never lays such wood (towerCatches) and the verdict refuses a roll with it (towerGates).
+ */
+export function sealedNear(g: Box, x0: number, x1: number, y: number): 'onto' | 'low' | undefined {
+  if (y <= g.y + GATE_LEVEL) return undefined;
+  const under = x0 < g.x + g.width + GATE.lidSide && x1 > g.x - GATE.lidSide;
+  if (under && y - g.y < sealedRoom(g)) return 'low';
+  const inLid = x0 >= g.x - GATE.lidSide && x1 <= g.x + g.width + GATE.lidSide;
+  return !inLid && leaps({ x: x0, y, width: x1 - x0 }, { x: g.x, y: g.y + GATE.sag, width: g.width }) ? 'onto' : undefined;
+}
