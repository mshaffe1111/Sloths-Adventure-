+      ctx.lineWidth = 13 - 4 * s;
+      ctx.beginPath();
+      ctx.moveTo(lx - 12 + shiver, 28);
+      ctx.quadraticCurveTo(lx - 16 + shiver, -H - 10 - lift, lx + shiver, -H - 6 - lift);
