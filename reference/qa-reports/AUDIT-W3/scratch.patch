new file mode 100755
index 000000000..86ed37b03
--- /dev/null
+++ b/tools/audit/four.sh
@@ -0,0 +1,9 @@
+#!/bin/bash
+# four.sh <tag> <stage...>: rolls each stage's code from ../codes-<tag>.txt on the wide pool, in turn
+tag=$1; shift
+for st in "$@"; do
+  C=$(grep "^$st " ../codes-$tag.txt | cut -d' ' -f2-)
+  case $st in 3-1|3-5) tr=down; td=down;; 3-4) tr=up; td=up;; 3-7) tr=left; td=level;; *) tr=right; td=level;; esac
+  AUDIT_CAP=20 ./tools/audit/roll.sh $st wide "$C" $tr $td > ../out/$st-$tag.txt 2>&1
+done
+echo done
