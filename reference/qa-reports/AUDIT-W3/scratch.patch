+#!/bin/bash
+# roll.sh <stage> <pool w3|wide> <code> [travel] [trend]
+export GEN2_DRAFT=$1 AUDIT_STAGE=$1 AUDIT_POOL=$2 AUDIT_CODE="$3" AUDIT_TRAVEL=${4:-right} AUDIT_TREND=${5:-level}
+timeout 900 npx tsx tools/audit/raw.ts 2>&1
