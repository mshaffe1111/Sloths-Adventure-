+import '../../src/game/headlessDom.ts';
+import { listedStage } from '../../src/game/gen2/listed.ts';
+const ids = process.argv.slice(2);
+for (const id of ids) { const r = listedStage(id); if (!r) { console.log(id, 'no row'); continue; }
+  const k = r.kit(); const s = k.manifest.sections;
+  const c: Record<string, string[]> = {};
+  for (const t of s) { const key = `${(t.jobs ?? ['-']).join('/')}:${t.content ?? '-'}`; (c[key] ??= []).push(t.id); }
+  console.log(id, s.length, Object.entries(c).map(([k, v]) => `${k}=${v.length}`).join(' '));
+}
diff --git a/tools/audit/raw.ts b/tools/audit/raw.ts
new file mode 100644
index 000000000..db90a9f3f
--- /dev/null
+++ b/tools/audit/raw.ts
@@ -0,0 +1,25 @@
+import '../../src/game/headlessDom.ts';
+import '../engine/draft.ts';
+import { buildStage, SETTINGS } from '../engine/libstage.ts';
+const id = process.env.AUDIT_STAGE!; const n = Number(process.env.SEEDS ?? 4);
+const seen = new Map<string, number>();
+const note = (k: string) => seen.set(k, (seen.get(k) ?? 0) + 1);
+let clean = 0;
+for (const d of SETTINGS) for (let s = 1; s <= n; s++) {
+  for (let tries = 0; ; tries++) try {
+    const st: any = buildStage(id, s, d);
+    const v = st.gen2.verdicts?.[d];
+    const errs = [...(v && !v.accepted ? v.failed.map((f: any) => `verdict ${f.name}: ${f.line}`) : []), ...(st.gen2.errors ?? [])];
+    if (!errs.length) { clean++; note(`${d} CLEAN plan=${(st.gen2.plan ?? []).map((p: any) => p.template).join(',')} code=${st.gen2.codeString ?? ''}`); }
+    for (const e of errs) note(`${d} ERR ${String(e).slice(0, 400)}`);
+    break;
+  } catch (e) {
+    const er = e as Error;
+    const wide = /^gen2 section (w[12]-\S+?):? |section (w[12]-\S+) is \d+ px wide, wider than the tower/.exec(er.message);
+    if (wide && tries < 60) { process.env.AUDIT_EXCLUDE = `${process.env.AUDIT_EXCLUDE ?? ''},${wide[1] ?? wide[2]}`; continue; } const at = (er.stack ?? '').split('\n').find((l) => /src\/game|tools\/engine/.test(l))?.trim().replace(/.*wt\//, '') ?? '';
+    note(`${d} THROW ${er.message.slice(0, 400)} @ ${at}`);
+    break;
+  }
+}
+for (const [k, c] of seen) console.log(`${c}x ${k}`);
+console.log(`clean ${clean}/${2 * n}`); if (process.env.AUDIT_EXCLUDE) console.log(`(reused W1/W2 sections that threw on W3's budget, left out: ${process.env.AUDIT_EXCLUDE.split(',').filter(Boolean).length})`);
