diff --git a/src/game/gen2/worlds/w3Audit.ts b/src/game/gen2/worlds/w3Audit.ts
new file mode 100644
index 000000000..ad1574ce1
--- /dev/null
+++ b/src/game/gen2/worlds/w3Audit.ts
@@ -0,0 +1,54 @@
+/**
+ * AUDIT-W3 SCRATCH ONLY (never lands): World 3's kit (dark + spore merged) with a design's node string as its one graph, so the real
+ * pipeline rolls the design. AUDIT_CODE = the node string; AUDIT_POOL = 'w3' (World 3's own bricks only) or 'wide' (every typed section
+ * Worlds 1-2 hold, World 3's bricks over them: the "nearest existing piece" test); AUDIT_TREND / AUDIT_TEACH optional.
+ */
+import { parseCode } from '../nodeCode.ts';
+import { TYPE_OF_LETTER } from '../nodeAsks.ts';
+import type { ContentType, GraphBrief, NodeJob, SectionTemplate, WorldKit } from '../types.ts';
+import { generateAllLevels } from '../../worldsData.ts';
+import { w1World } from './w1.ts';
+import { w2World } from './w2.ts';
+import { w3World, w3Drops, w3Walk, w3Ledge } from './w3.ts';
+import { darkEnds } from '../dark.ts';
+
+const ARCH = ['sprint', 'harvest', 'purge', 'ascent', 'stealth', 'vine_runner', 'relic_hunt', 'rescue', 'gauntlet', 'snake', 'eagle', 'ocelot', 'turtle', 'jaguar', 'boa', 'caiman', 'tayra'];
+const ALL_JOBS: NodeJob[] = ['teach', 'practise', 'test', 'combine', 'twist', 'signature', 'descent', 'climb', 'flow'];
+
+/** World 3's own bricks as an audit pool: the dark drops (glowworms), the same with a puff on the middle shelf, the shelf walk */
+export function w3AuditBricks(): SectionTemplate[] {
+  const cap = Number(process.env.AUDIT_CAP ?? 6);
+  const drops: SectionTemplate = { ...w3Drops, maxPerStage: cap, id: 'audit-dark-drops', jobs: ALL_JOBS, content: 'ground' };
+  const puff: SectionTemplate = { ...w3Drops, maxPerStage: cap, id: 'audit-puff-drops', jobs: ALL_JOBS, content: 'ground', zones: [...(w3Drops.zones ?? []), { kind: 'spore', on: 'b' }] };
+  const walk: SectionTemplate = { ...w3Walk, maxPerStage: cap, id: 'audit-walk', jobs: ALL_JOBS, content: 'floating', sockets: [...darkEnds('near', 'far', 'glow'), ...w3Walk.sockets] };
+  const arrive: SectionTemplate = { ...w3Ledge, id: 'audit-arrive', jobs: ['arrive'], content: 'structural', phases: ['start'] };
+  const rest: SectionTemplate = { ...w3Ledge, id: 'audit-rest', jobs: ['rest'], content: 'structural', phases: ['rest'], maxPerStage: cap };
+  const exit: SectionTemplate = { ...w3Ledge, id: 'audit-exit', jobs: ['exit'], content: 'structural', phases: ['goal'] };
+  return [arrive, rest, exit, drops, puff, walk];
+}
+
+export function auditKit(): WorldKit {
+  const stage = process.env.AUDIT_STAGE ?? '3-1';
+  const code = process.env.AUDIT_CODE ?? '';
+  const k = w3World(), M = k.manifest;
+  const cfg = generateAllLevels().find((c) => c.id === stage)!;
+  const archetype = ((cfg as unknown as { objective?: { type?: string } }).objective?.type ?? 'sprint') as never;
+  const own = w3AuditBricks();
+  const maxW = Number(process.env.AUDIT_MAXW ?? 1e9);
+  const span = (s: SectionTemplate) => s.pieces.reduce((a, q) => a + (Array.isArray(q.w) ? q.w[1] : (q.w as number ?? 0)) + 120, 0);
+  const typed = (s: SectionTemplate) => !!s.jobs?.length && !!s.content && s.content !== 'structural' && span(s) <= maxW && !(process.env.AUDIT_EXCLUDE ?? '').split(',').includes(s.id);
+  const wide = process.env.AUDIT_POOL === 'wide'
+    ? [...w1World().manifest.sections, ...w2World().manifest.sections].filter(typed).map((s) => ({ ...s, feel: undefined, own: undefined, maxPerStage: Number(process.env.AUDIT_CAP ?? 6), sockets: (s.sockets ?? []).filter((q) => q.role !== 'tip') }))
+    : [];
+  const deal: Partial<Record<ContentType, number>> = {};
+  for (const t of parseCode(code.replace(/F\[.*?\]/g, ''))) {
+    const ty = t.content ? TYPE_OF_LETTER[t.content] : undefined;
+    if (ty) deal[ty] = (deal[ty] ?? 0) + 1;
+  }
+  const brief: GraphBrief = {
+    ends: 'quiet', trend: (process.env.AUDIT_TREND as GraphBrief['trend']) ?? 'level', branching: 'none',
+    teaches: process.env.AUDIT_TEACH ? process.env.AUDIT_TEACH.split(',') : [], deal, dealExact: true, ...(process.env.AUDIT_SOFT === '1' ? { softFalls: true } : {}),
+  } as GraphBrief;
+  return { ...k, manifest: { ...M, sections: [...own, ...wide] as SectionTemplate[], required: {},
+    graphs: { list: ARCH.map((a) => ({ id: `audit-${stage}-${a}`, archetype: a as never, code })), briefs: { [stage]: brief }, maxPerStage: Number(process.env.AUDIT_CAP ?? 6) } } } as WorldKit;
+}
