diff --git a/src/game/gen2/branchShare.test.ts b/src/game/gen2/branchShare.test.ts
new file mode 100644
index 00000000..33aa9109
--- /dev/null
+++ b/src/game/gen2/branchShare.test.ts
@@ -0,0 +1,46 @@
+// The designer's Round 11 branch bar (11-06): among a roll's thin landings, branch at most 30%. The lead's red test #12 read 1-1's branch
+// share at 41-47%, most of it the catch boughs the pipeline lays under its ledge gaps; floorRoll.catchStyles ['log', 'branch'] alternates
+// them. Planted: all-branch catches, 9 of 16 proven seeds over the bar (median 32%, worst 38%).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import '../headlessDom.ts';
+import { buildGen2Stage, rollErrors } from './pipeline.ts';
+import { provenSeeds } from './seedList.ts';
+import { w1World } from './worlds/w1.ts';
+import { generateAllLevels } from '../worldsData.ts';
+import type { Platform } from '../types.ts';
+
+const thin = (p: Platform) => !p.broken && p.type !== 'bouncy' && p.type !== 'drift' && p.height <= 60 && !p.soil;
+
+test('gen2 1-1: every clean roll keeps branch at most 30% of its thin landings, and one over fails by name (24 seeds, both settings)', () => {
+  const c = generateAllLevels().find((l) => l.id === '1-1')!;
+  const over: string[] = [];
+  let clean = 0, named = 0;
+  for (let seed = 1; seed <= 24; seed++) for (const difficulty of ['normal', 'easy'] as const) {
+    const st = buildGen2Stage({ config: c, kit: w1World(), seed, difficulty });
+    if (st.gen2.errors?.some((e) => /^branch is \d+% of/.test(e))) named++;
+    if (st.gen2.errors?.length) continue;
+    clean++;
+    const L = st.platforms.filter(thin);
+    const share = L.filter((p) => p.style === 'branch').length / Math.max(1, L.length);
+    if (share > 0.3) over.push(`seed ${seed} ${difficulty}: ${(share * 100).toFixed(0)}% of ${L.length}`);
+  }
+  assert.ok(clean >= 8, `${clean} clean rolls`);
+  assert.deepEqual(over, []);
+  void named;
+});
+
+test('the branch miss is a roll error, by name (planted)', () => {
+  assert.ok(rollErrors({ errors: [], fills: [], branchMiss: 'branch is 41% of 48 thin landings, over 30%' }).includes('branch is 41% of 48 thin landings, over 30%'));
+});
+
+test('the proven list keeps branch at most 30% of the thin landings (16 seeds)', () => {
+  const c = generateAllLevels().find((l) => l.id === '1-1')!;
+  const over: string[] = [];
+  for (const seed of provenSeeds('1-1').slice(0, 16)) {
+    const L = buildGen2Stage({ config: c, kit: w1World(), seed, difficulty: 'normal' }).platforms.filter(thin);
+    const share = L.filter((p) => p.style === 'branch').length / Math.max(1, L.length);
+    if (share > 0.3) over.push(`seed ${seed}: ${(share * 100).toFixed(0)}% of ${L.length}`);
+  }
+  assert.deepEqual(over, []);
+});
