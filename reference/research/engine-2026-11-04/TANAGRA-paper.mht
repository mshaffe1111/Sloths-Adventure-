.textLayer ::selection { background: rgb(0, 0, 255); }

.textLayer .endOfContent { display: block; position: absolute; inset: 100% 0px 0px; z-index: -1; cursor: default; user-select: none; }

.textLayer .endOfContent.active { top: 0px; }

